type: "SpreadEffect"
name: "Протокол Вектор"
description: "Высокозаразный энергетический вирус. Каждые 60 тиков испускает импульс, заражающий всех ближайших врагов в радиусе. Повторное заражение целей вызывает внутренний коллапс обшивки и наносит тяжелый пробивающий урон."


spreadRadius: 40.0

spreadInterval: 60.0

spreadSingle: false


spreadEnemies: true
spreadAllies: true


damage: 0.45


